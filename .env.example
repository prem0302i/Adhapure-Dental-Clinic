# Public-facing config (safe to expose to browser)
# WhatsApp number in international format, digits only, no + symbol.
# Example: 447700900123
VITE_WHATSAPP_NUMBER=

# Supabase Public Configuration (Vite or Next.js prefix supported)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# or
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for backend migrations and admin CLI scripts.
# NEVER prefix with VITE_ or expose to the client browser.
SUPABASE_SERVICE_ROLE_KEY=
